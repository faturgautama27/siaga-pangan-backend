# Salin file ini menjadi .env untuk development lokal
# JANGAN commit file .env ke repository

# Turso Database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT
JWT_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter
JWT_TTL_SECONDS=28800

# CORS — pisahkan beberapa origin dengan koma
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://siaga-pangan.vercel.app

# Upload
MAX_UPLOAD_BYTES=10485760

# Environment
APP_ENV=development
